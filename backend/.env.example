# Copy to backend/.env for local runs. Never commit the real key.
YOUTUBE_API_KEY=
# Comma-separated origins allowed to call the API from a browser (the mobile app does not need CORS).
ALLOWED_ORIGINS=http://localhost:8081
# Requests per minute per client.
RATE_LIMIT_PER_MINUTE=30
# Set to true only when running behind a trusted proxy (e.g. Render) that sets X-Forwarded-For.
TRUST_PROXY=false
