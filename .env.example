# Copy to .env and fill in to enable optional cloud backup (see docs/SUPABASE_SETUP.md).
# Only client-safe PUBLIC values belong here. Never put a secret / service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key

# DIONER backend (video tutorials). Local dev on the same Wi-Fi: http://<your-PC-LAN-IP>:8000
# Production: the https URL of your deployed backend.
EXPO_PUBLIC_API_URL=
